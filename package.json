{
  "name": "poe-qol-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Path of Exile quality-of-life companion with character dashboard and passive tree overlay.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run package",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "package": "electron-builder --win nsis --publish=never",
    "release": "electron-builder --win nsis --publish=never"
  },
  "dependencies": {
    "electron": "^31.2.0"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.komil.poe-qol-overlay",
    "productName": "PoEQoLOverlay",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-setup-${version}.exe"
    }
  }
}
